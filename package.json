{
  "name": "student-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-export.mjs",
    "typegen": "next typegen",
    "lint": "eslint .",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse-budget.mjs",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "analyze": "ANALYZE=true next build --webpack",
    "validate:ui": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:bundle"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

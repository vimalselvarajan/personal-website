{
  "name": "student-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "preinstall": "node scripts/verify-toolchain.mjs",
    "check:toolchain": "node scripts/verify-toolchain.mjs",
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-export-cli.mjs",
    "typegen": "next typegen",
    "lint": "node scripts/lint.mjs",
    "typecheck": "npm run typegen && node scripts/typecheck.mjs",
    "test": "vitest run",
    "assets:generate": "node scripts/profile-images.mjs && node scripts/project-images.mjs && node scripts/research-images.mjs",
    "assets:check": "node scripts/profile-images.mjs --check && node scripts/project-images.mjs --check && node scripts/research-images.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:export": "playwright test",
    "test:lighthouse": "node scripts/lighthouse-budget.mjs",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e:update": "npm run build && playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "analyze": "ANALYZE=true next build --webpack",
    "validate:ui": "playwright test",
    "validate": "npm run check:toolchain && npm run lint && npm run typecheck && npm run test:coverage && npm run assets:check && npm run build && npm run test:bundle"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@axe-core/playwright": "4.13.0",
    "@next/bundle-analyzer": "16.3.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
